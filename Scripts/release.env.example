# 复制为项目根目录的 .release.env，填写完成后执行：
# source .release.env
# bash Scripts/release.sh
export APP_VERSION='0.1.0'
export BUILD_NUMBER='1'
export CODE_SIGN_IDENTITY='Developer ID Application: 你的姓名或公司名 (TEAMID)'
export APP_STORE_CONNECT_API_KEY_PATH="$HOME/Downloads/AuthKey_KEYID.p8"
export APP_STORE_CONNECT_API_KEY_ID='KEYID'
# 团队 API Key 必填；个人 API Key 不设置 Issuer ID。
export APP_STORE_CONNECT_API_ISSUER_ID='填写团队 Issuer ID'
